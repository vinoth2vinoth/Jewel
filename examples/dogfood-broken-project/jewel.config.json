{
  "projectName": "dogfood-broken-project",
  "mode": "strict",
  "maxRetries": 3,
  "maxFilesChanged": 3,
  "maxLinesChanged": 200,
  "requirePlanBeforeEdit": true,
  "requireVerificationBeforeDone": true,
  "allowNewDependencies": false,
  "allowProtectedFileChanges": false,
  "allowGitPush": false,
  "requireHumanDiffApproval": false,
  "provider": "none",
  "model": "gpt-4o-mini",
  "temperature": 0,
  "maxOutputTokens": 4000,
  "llmTimeoutMs": 60000,
  "llmMaxRetries": 1,
  "llmStrictJson": true,
  "commands": {
    "build": "npm run build",
    "test": "npm run test"
  },
  "protectedFiles": [
    "package.json"
  ]
}
